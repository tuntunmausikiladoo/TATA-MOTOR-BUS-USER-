rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read/write their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Drivers can read/write their own data
    match /drivers/{driverId} {
      allow read, write: if request.auth != null && request.auth.uid == driverId;
    }
    
    // Bookings - users can read/write their own bookings, drivers can read/write assigned bookings
    match /bookings/{bookingId} {
      allow read, write: if request.auth != null && (
        resource.data.userId == request.auth.uid || 
        resource.data.driverId == request.auth.uid ||
        (resource.data.driverId == null && request.auth.token.role == 'driver')
      );
    }
    
    // Available bookings - drivers can read pending bookings
    match /availableBookings/{bookingId} {
      allow read: if request.auth != null && request.auth.token.role == 'driver';
      allow write: if request.auth != null && (
        resource.data.userId == request.auth.uid || 
        request.auth.token.role == 'driver'
      );
    }
    
    // Bus locations - drivers can update their own location, users can read assigned driver location
    match /busLocations/{driverId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == driverId;
    }
  }
} 